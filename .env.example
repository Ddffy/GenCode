# Environment-variable fallback only. Prefer .gencode.toml for provider profiles.

# DeepSeek uses its Anthropic-compatible endpoint by default.
GENCODE_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
GENCODE_DEEPSEEK_API_KEY=
GENCODE_DEEPSEEK_MODEL=deepseek-v4-flash

# Optional shared right.codes key. Used by OpenAI-compatible and
# Anthropic-compatible profiles when provider-specific keys are empty.
GENCODE_RIGHT_CODES_API_KEY=

# OpenAI-compatible endpoint.
GENCODE_OPENAI_API_BASE=https://www.right.codes/codex/v1
GENCODE_OPENAI_API_KEY=
GENCODE_OPENAI_MODEL=gpt-5.4

# Anthropic-compatible endpoint.
GENCODE_ANTHROPIC_API_BASE=https://www.right.codes/claude/v1
GENCODE_ANTHROPIC_API_KEY=
GENCODE_ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional comma-separated extra env names to redact from traces and reports.
GENCODE_SECRET_ENV_NAMES=

# Qwen hybrid retrieval. These are the built-in defaults, so a .env entry is only
# needed to override them. Without a key the remote provider degrades to
# sparse-only retrieval and records the reason in `degraded_reasons`; use
# GENCODE_EMBEDDING_PROVIDER=hashing for the dependency-free offline fallback.
GENCODE_EMBEDDING_PROVIDER=openai-compatible
GENCODE_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
GENCODE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
GENCODE_EMBEDDING_API_KEY=
GENCODE_EMBEDDING_DIMENSIONS=1024
GENCODE_EMBEDDING_BATCH_SIZE=20
GENCODE_RERANKER_PROVIDER=dashscope
GENCODE_RERANKER_MODEL=qwen3.7-text-rerank
GENCODE_RERANKER_BASE_URL=https://dashscope.aliyuncs.com/api/v1
GENCODE_RERANKER_API_KEY=
GENCODE_RERANKER_TIMEOUT=30
GENCODE_RETRIEVAL_SPARSE_TOP_K=50
GENCODE_RETRIEVAL_DENSE_TOP_K=50
GENCODE_RETRIEVAL_COARSE_TOP_K=20
GENCODE_RETRIEVAL_FINAL_TOP_K=5

# Child chunking: parents are structural (file / page), children are recursive.
GENCODE_RETRIEVAL_CHILD_CHUNK_TOKENS=300
GENCODE_RETRIEVAL_CHILD_CHUNK_OVERLAP=0.10
GENCODE_RETRIEVAL_PARENT_MAX_CHUNKS=2

# Small-to-big: match children, hand generation the whole section.
GENCODE_RETRIEVAL_SECTION_EXPAND=true
GENCODE_RETRIEVAL_SECTION_MAX_CHARS=2400
GENCODE_RETRIEVAL_SECTION_WINDOW_LINES=12
#
# Abstention floor. Calibrated on 49 wiki tasks: answerable queries scored
# >= 0.68, unanswerable <= 0.61, so 0.65 sits inside the gap. Re-calibrate for
# your own corpus and reranker — the number is bound to the reranker that
# produced it. Only applies to a relevance-scoring reranker (dashscope /
# cross-encoder); with `deterministic` the floor is reported as ignored.
# GENCODE_RETRIEVAL_ABSTENTION_MIN_RERANK=0.65
