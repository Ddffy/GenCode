# Environment-variable fallback only. Prefer .gencode.toml for provider profiles.

# DeepSeek uses its Anthropic-compatible endpoint by default.
GENCODE_DEEPSEEK_API_BASE=https://api.deepseek.com/anthropic
GENCODE_DEEPSEEK_API_KEY=
GENCODE_DEEPSEEK_MODEL=deepseek-v4-flash

# Optional shared right.codes key. Used by OpenAI-compatible and
# Anthropic-compatible profiles when provider-specific keys are empty.
GENCODE_RIGHT_CODES_API_KEY=

# OpenAI-compatible endpoint.
GENCODE_OPENAI_API_BASE=https://www.right.codes/codex/v1
GENCODE_OPENAI_API_KEY=
GENCODE_OPENAI_MODEL=gpt-5.4

# Anthropic-compatible endpoint.
GENCODE_ANTHROPIC_API_BASE=https://www.right.codes/claude/v1
GENCODE_ANTHROPIC_API_KEY=
GENCODE_ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional comma-separated extra env names to redact from traces and reports.
GENCODE_SECRET_ENV_NAMES=
